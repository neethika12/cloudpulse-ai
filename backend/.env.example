DATABASE_URL=postgresql+psycopg2://cloudpulse:cloudpulse@db:5432/cloudpulse
ENVIRONMENT=development

# OpenAI key for the chat assistant. Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# --- Azure OpenAI (use this instead of OPENAI_API_KEY if your key is from Azure) ---
# When AZURE_OPENAI_ENDPOINT is set, all calls go to Azure and the model names are your
# *deployment names* (Azure portal > your resource > Model deployments).
# AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.services.ai.azure.com/openai/v1/   (the portal's endpoint URL works as-is, even ending in /responses)
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_API_VERSION=2024-10-21
# OPENAI_MODEL=<your chat deployment name>
# OPENAI_EMBEDDING_MODEL=<your embedding deployment name>
# EMBEDDING_SUPPORTS_DIMENSIONS=false   # only if the embedding deployment is text-embedding-ada-002
# Rerank/judge default to the chat deployment on Azure; override with OPENAI_RERANK_MODEL / OPENAI_JUDGE_MODEL.
# Optional RAG / eval settings (defaults shown)
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small   # set to empty (OPENAI_EMBEDDING_MODEL=) for keyword-only knowledge search, no embedding deployment needed
# OPENAI_RERANK_MODEL=gpt-4o-mini
# OPENAI_JUDGE_MODEL=gpt-4o-mini
# RAG_RERANK=true
# RAG_TOP_K=5

# Optional - leave blank to skip Slack alerts. See README for setup steps.
SLACK_WEBHOOK_URL=

# Auth - generate a real random secret for anything beyond local dev, e.g.:
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=dev-secret-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Encrypts AWS secret access keys at rest. Generate a real one for anything beyond
# local dev: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_ENCRYPTION_KEY=HicjRZLuUYNG8mY1YeYDN5WbfeESSC5ovmp793lVLrU=
# LLM_CHAT_API=auto   # chat | responses | auto (auto uses /responses for non gpt-4 models)
